# ============================================================================
# qq-bridge 前置消息分流与外部轻量路由配置
# 复制本文件为 .env 并填入实际值后重启 bridge.js 即可生效
# ============================================================================

# OpenAI 官方（或兼容接口）API Key
# 仅用于群聊消息的前置轻量回复意图分类；白名单私聊完全在本地直通，不调用任何外部接口
OPENAI_API_KEY=

# OpenAI 接口基础地址（默认使用官方 v1 地址；优先调用 /responses，404/405 时自动兼容 /chat/completions）
OPENAI_BASE_URL=https://api.openai.com/v1

# 群聊前置意图分类模型（默认 gpt-6-luna，强制使用无推理模式 reasoning effort = none 与极小输出上限）
ROUTER_MODEL=gpt-6-luna

# 私聊直通白名单 QQ 号（支持配置单个或多个 QQ 号，使用英文逗号分隔，如 10001,10002）
# 当收到 private 私聊且发送者在此列表内时，零外部请求直接转发至本地主对话会话
OWNER_QQ_IDS=
